# ============================================================================
# 🎄 PLANTILLA DE VARIABLES DE ENTORNO (.env.example)
# ============================================================================
# Copia este archivo como `.env` y personaliza tus llaves y banderas:

# --- 1. LLAVES Y BASE DE DATOS EN LA NUBE ---
CLOUD_DB_URL=https://tu-endpoint-api.com/api
CLOUD_DB_OBJECT_NAME=TU_APP_KEY_SECRETA
ADMIN_PIN=TU_PIN_SECRETO
STORAGE_KEY=intercambio_pijamas_bd_v1
PREFIJO_TOKEN=PIJAMA

# --- 2. BANDERAS (FLAGS) DE PARTICIPANTES Y SORTEO ---
MIN_PARTICIPANTES=13
MAX_PARTICIPANTES=20
AUTO_SORTEO_AL_MAX=true
PERMITIR_REGISTRO_EXTRA=false
MOSTRAR_BOTON_DEMO=false

# --- 3. DATOS DEL EVENTO Y ENLACES ---
TITULO_EVENTO=Intercambio Navideño de Pijamas Pachoncitas
FRASE_EVENTO=“Suaves, calientitas y con mucho espíritu navideño: ¡regala el abrazo más suave de esta Navidad!”
PRESUPUESTO_MXN=300
FECHA_REVELACION=2026-11-23
FECHA_REVELACION_TEXTO=Lunes 23 de noviembre
FECHA_EVENTO_TEXTO=24 de diciembre | Desde las 5:00 PM
FECHA_EVENTO_ISO=20261224T170000
FECHA_EVENTO_FIN_ISO=20261224T235900
LUGAR_EVENTO=Cena Navideña e Intercambio
SITIO_WEB_URL=https://tu-usuario.github.io/intercambio-pijamas/

# --- 4. CONFIGURACIÓN DE WHATSAPP Y SERVIDOR LOCAL ---
CODIGO_PAIS_WA=52
TIEMPO_ESPERA_WA_SEG=4.5
PORT=3000
